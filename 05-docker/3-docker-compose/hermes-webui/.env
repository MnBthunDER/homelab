# Hermes stack deploy-time variables (shell env for Compose interpolation).
# Secrets (HERMES_API_SERVER_KEY, HERMES_WEBUI_PASSWORD) live in Docker Swarm
# now — this file keeps only UID/GID. Deploy with:
#   set -a; source .env; set +a; docker stack deploy -c docker-compose.yaml hermes

# Host user mapping — must own /mnt/nas-nfs/hermes/* on the Swarm nodes.
# (This workspace shows root:root; the Swarm nodes use 1000:1000.)
UID=1000
GID=1000
